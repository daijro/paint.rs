<?xml version="1.0" encoding="utf-8"?>
<!-- Only the official source. These projects declare no PackageReferences, but the
     net10 SDK still restores targeting/runtime ref packs (e.g. AspNetCore.App.Ref)
     that are not installed locally; one restore populates .build/nuget, then builds
     run offline. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
