<Project Sdk="Microsoft.NET.Sdk">
  <!-- System.Windows.Forms.Primitives: since .NET 7 WinForms defines Padding and Message here, so plugins built
       against .NET 7+ WinForms (Ed Harvey's) reference them from this assembly; ../WindowsForms forwards them,
       for plugins built against .NET Framework's System.Windows.Forms. -->
  <PropertyGroup>
    <AssemblyName>System.Windows.Forms.Primitives</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <Version>10.0.0.0</Version>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
</Project>
