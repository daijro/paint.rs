<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PaintDotNet.Core</AssemblyName>
    <!-- Core's IRenderer (the older shape) hides Primitives' by name, on purpose: see RendererExtensions.Primitives.cs. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <RootNamespace>PaintDotNet</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Windows/Windows.csproj" />
    <!-- prim:: names Primitives' IRenderer, which Core's own (older) IRenderer hides (RendererExtensions.Primitives.cs). -->
    <ProjectReference Include="../Primitives/Primitives.csproj" Aliases="global,prim" />
    <!-- IndirectUI describes controls per Property. -->
    <ProjectReference Include="../PropertySystem/PropertySystem.csproj" />
    <!-- IClipboardService extends Base's IClipboard. -->
    <ProjectReference Include="../Base/Base.csproj" />
    <!-- PdnBaseForm and HeaderLabel, which classic plugins' settings dialogs build on. -->
    <ProjectReference Include="../WindowsForms/WindowsForms.csproj" />
    <!-- RenderArgs exposes a GDI+ Graphics/Bitmap aliasing the surface for classic effects that
         draw (Polygon, ComplementaryColors, …). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PaintDotNet.Effects.Core" />
    <InternalsVisibleTo Include="PaintDotNet.Data" />
    <InternalsVisibleTo Include="PdnBridge" />
    <InternalsVisibleTo Include="PaintNetWeb" />
  </ItemGroup>
</Project>
