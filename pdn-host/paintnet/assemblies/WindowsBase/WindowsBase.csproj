<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF's WindowsBase for plugins: .NET's is a facade without WPF's own types, and a plugin may use its Point
       (toe_head2001's Radius Corners). Not referenced by the bridge (the framework ships an assembly of this name):
       publish.sh builds it into plugin-shims/, which the plugin load context checks first. It keeps the facade's
       forwards that land in the framework. -->
  <PropertyGroup>
    <AssemblyName>WindowsBase</AssemblyName>
    <RootNamespace>System.Windows</RootNamespace>
    <Version>4.0.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
  </PropertyGroup>
</Project>
