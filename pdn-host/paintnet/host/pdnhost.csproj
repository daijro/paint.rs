<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pdnhost</AssemblyName>
    <RootNamespace>PdnHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Pure reflection host: it links NONE of the Paint.NET replacement
         assemblies, so the one binary drives both the shim (Linux) and the
         genuine assemblies (Windows) unchanged. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Carried so a plugin's System.Drawing.Common reference resolves at runtime
         (System.Drawing.Image appears on the classic effect ctors). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
</Project>
