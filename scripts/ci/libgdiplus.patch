+		/* the corner at p1, to the next segment */
+		q = pts[(k + 2) % n];
+		ex = q.X - p1.X; ey = q.Y - p1.Y; elen = sqrt (ex * ex + ey * ey);
+		mx = -ey / elen * side; my = ex / elen * side;
+		cross = (dx * ey - dy * ex) / (len * elen);
+		dot = (dx * ex + dy * ey) / (len * elen);
+		if (cross * side > 0) {
+			/* the inner side: the offset lines meet, unless a segment is too short for it */
