+/* A cap at end p of an open figure, from its side at offset +n·h round to the other, d the direction outwards. */
+static BOOL
+widen_cap (WidenOut *out, GpLineCap cap, GpPointF p, double dx, double dy, float h, float flatness)
+{
+	double nx = -dy, ny = dx;
+	switch (cap) {
+	case LineCapSquare:
+	case LineCapSquareAnchor:
+		return widen_add (out, p.X + (nx + dx) * h, p.Y + (ny + dy) * h, FALSE)
