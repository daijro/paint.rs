+/* The outline a pen draws along a path, for GdipWidenPath: each figure's two sides, offset by half the pen's width,
+ * with the pen's joins at its corners and its caps at an open figure's ends. */
+typedef struct {
+	GpPointF *points;
+	BYTE *types;
+	int count, size;
+} WidenOut;
+
+static BOOL
+widen_add (WidenOut *out, float x, float y, BOOL start)
+{
+	if (out->count == out->size) {
+		int size = out->size ? out->size * 2 : 64;
+		GpPointF *points = gdip_realloc (out->points, size * sizeof (GpPointF));
+		BYTE *types;
+		if (!points)
+			return FALSE;
+		out->points = points;
+		types = gdip_realloc (out->types, size * sizeof (BYTE));
+		if (!types)
+			return FALSE;
+		out->types = types;
+		out->size = size;
+	}
+	out->points[out->count].X = x;
+	out->points[out->count].Y = y;
+	out->types[out->count] = start ? PathPointTypeStart : PathPointTypeLine;
+	out->count++;
+	return TRUE;
+}
+
+static void
+widen_close (WidenOut *out)
+{
+	if (out->count > 0)
+		out->types[out->count - 1] |= PathPointTypeCloseSubpath;
+}
+
+/* An arc of radius r around c from angle a0 sweeping by sweep (radians), its first point excluded. */
+static BOOL
+widen_arc (WidenOut *out, GpPointF c, float r, double a0, double sweep, float flatness)
+{
+	double step = (r > flatness) ? 2 * acos (1 - flatness / r) : M_PI / 2;
+	int n, i;
+	if (step < M_PI / 64)
+		step = M_PI / 64;
+	n = (int) ceil (fabs (sweep) / step);
+	if (n < 1)
+		n = 1;
+	for (i = 1; i <= n; i++) {
+		double a = a0 + sweep * i / n;
+		if (!widen_add (out, c.X + r * cos (a), c.Y + r * sin (a), FALSE))
+			return FALSE;
+	}
+	return TRUE;
+}
+
+/* One side of a figure's points pts[0..n): offset by h along each segment's left normal times side (1 or -1),
